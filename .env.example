# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------
# Google Gemini API key (server-side only; never in frontend)
GEMINI_API_KEY=
# Primary hosted Gemma model
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_PROVIDER=google
GEMMA_TIMEOUT_SECONDS=60
# Provider mode default: hosted | local | mock
PROVIDER_MODE=hosted
# Backend
# Leave DATABASE_URL unset to use <repo>/storage/lamer_konekte.sqlite3.
# If you do set it, a relative path is resolved against the repo root (not the
# directory you launched the server from).
# DATABASE_URL=sqlite:///storage/lamer_konekte.sqlite3
UPLOAD_MAX_BYTES=8388608
MEDIA_RETENTION=delete_after_analysis
LOG_LEVEL=INFO
# Marine API (no key required — Open-Meteo)
MARINE_API_BASE=https://marine-api.open-meteo.com/v1/marine
MARINE_CACHE_MINUTES=30
# Demo
DEMO_MODE=false
