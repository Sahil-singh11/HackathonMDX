# Frontend environment. Copy to frontend/.env.local and edit.
#
# THIS FILE MUST NEVER CONTAIN A SECRET.
# Vite inlines every VITE_* variable into the JavaScript bundle in clear text, so
# anything here is published to every visitor. GEMINI_API_KEY is backend-only and
# belongs in the repo-root .env (local) or Render's environment variables (shared).
# There is deliberately no VITE_GEMINI_API_KEY, and a test asserts one never appears.
# -----------------------------------------------------------------------------

# Where the backend lives. This single variable is the only difference between the
# two supported modes.
#
# MODE A — shared Render backend (recommended). No local API key needed: hosted
# Gemma is called by the deployed backend.
VITE_API_BASE_URL=https://lamer-konekte.onrender.com
#
# MODE B — local full stack. Leave this EMPTY (or comment the line out) so requests
# stay relative and Vite's dev proxy forwards /api and /health to 127.0.0.1:8000.
# Requires an authorised GEMINI_API_KEY in the repo-root .env.
# VITE_API_BASE_URL=
